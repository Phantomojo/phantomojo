  <!-- GhostWire Featured -->
  <div class="featured-card">
    <div class="featured-header">
      <div class="featured-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#DB9202" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
